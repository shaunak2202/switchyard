# Copy to .env and fill in. .env is gitignored.

# Groq (optional). If empty, the groq provider is disabled and routes fall back to the others.
GROQ_API_KEY=

# Ollama running on the host (optional). From inside Docker the host is host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# JSON logs level: DEBUG | INFO | WARNING | ERROR
SWITCHYARD_LOG_LEVEL=INFO
